PORT=8000
NODE_ENV=development
MAX_VIDEO_SIZE_MB=100
UPLOAD_DIR=uploads
EXTRACTED_DIR=extracted
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_DURATION_SECONDS=300
MAX_FRAMES=300
FFMPEG_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_DELAY_MS=500
OPENAI_MAX_OUTPUT_TOKENS=2000
MAX_ANALYSIS_FRAMES=8
ANALYSIS_FRAME_MAX_DIMENSION=768
ANALYSIS_JPEG_QUALITY=70
MAX_ANALYSIS_FRAME_BYTES=512000
VISUAL_FRAME_DIFF_THRESHOLD=12
MAX_TRANSCRIPTION_AUDIO_BYTES=26214400
ANALYSIS_TRANSCRIPT_MAX_CHARACTERS=20000
